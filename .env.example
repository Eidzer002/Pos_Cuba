# POS Cuba - Variables de Entorno
# Copiar este archivo a .env y completar los valores
# O usar --dart-define al compilar

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# PowerSync Configuration
POWERSYNC_URL=https://your-powersync-instance.powersync.co

# NOTA: En produccion, usar --dart-define para mayor seguridad:
# flutter run --dart-define=SUPABASE_URL=... --dart-define=SUPABASE_ANON_KEY=... --dart-define=POWERSYNC_URL=...
