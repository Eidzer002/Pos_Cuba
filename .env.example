# POS Cuba - Variables de Entorno
# Copiar este archivo a .env y completar con tus valores reales
# O usar --dart-define al compilar

# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# PowerSync Configuration
POWERSYNC_URL=https://your-instance-id.powersync.journeyapps.com

# NOTA: En produccion, usar --dart-define para mayor seguridad:
# flutter build apk \
#   --dart-define=SUPABASE_URL=https://your-project-ref.supabase.co \
#   --dart-define=SUPABASE_ANON_KEY=your-anon-key \
#   --dart-define=POWERSYNC_URL=https://your-instance-id.powersync.journeyapps.com
